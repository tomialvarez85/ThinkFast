# Copiá este archivo como backend/.env y completá los valores.

# --- Base de datos (opcional) ---
# Si lo dejás vacío, los mensajes solo se envían por email.
MONGO_URL=mongodb://localhost:27017
DB_NAME=thinkfast

# --- Aviso por email cuando llega un contacto ---
# Con Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación"
# en https://myaccount.google.com/apppasswords (no uses tu contraseña normal).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=tu-contraseña-de-aplicacion
NOTIFY_EMAIL=tu-cuenta@gmail.com

# --- Acceso a la lista de mensajes (GET /api/contact con encabezado X-Admin-Token) ---
# Usá un valor largo y aleatorio. Si lo dejás vacío, el endpoint queda deshabilitado.
ADMIN_TOKEN=

# --- CORS: dominios autorizados a usar la API, separados por coma ---
CORS_ORIGINS=http://localhost:3000
